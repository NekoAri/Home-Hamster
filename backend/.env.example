# ============================================================
# HomeHamster 环境变量配置
# 复制此文件为 .env 并填写实际值: cp .env.example .env
# ============================================================

# ---- 数据库配置 ----
DB_HOST=localhost
DB_PORT=5432
DB_USER=homehamster
DB_PASSWORD=homehamster
DB_NAME=homehamster

# ---- 应用配置 ----
DEBUG=true

# 注意：LLM 配置（供应商、API Key、模型名称等）已迁移到数据库存储
# 请在前端「设置 → 模型配置」中添加并管理 LLM 配置
# 支持 OpenAI / Anthropic Claude / DeepSeek / 智谱 GLM / Ollama 等多供应商
